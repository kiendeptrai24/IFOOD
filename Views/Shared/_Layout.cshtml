@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@{
    var appUser = User.Identity?.IsAuthenticated == true 
    ? await UserManager.GetUserAsync(User) 
    : null;
    var avatarUrl = appUser?.ProfileImageUrl ?? "https://placehold.co/30x30";
    var botAvatarUrl = Url.Content("~/Chatbot.jpg");
}
<html lang="en">
<head>
    <title>iFood</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/cutlery.png")" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/SimpleLightbox/2.1.0/simpleLightbox.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.2/sweetalert2.min.css">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/scripts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/SimpleLightbox/2.1.0/simpleLightbox.min.js"></script>
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.10.2/sweetalert2.all.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Fix alert notification positioning */
        .alert.alert-danger {
            z-index: 10000 !important;
        }
        /* Ensure navbar stays below alerts */
        .navbar.sticky-top {
            z-index: 1030;
        }
    </style>
</head>
<body id="page-top">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top py-3" style = "background: rgba(119, 0, 210, 1);">
            <div class="container px-4 px-lg-5">
                <a class="navbar-brand fw-bold text-white" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-utensils"></i>
                @* <i class="fas fa-utensils text-white" style="font-size: 6rem; z-index: 2; position: relative;"/> *@
                @* <i class="bi bi-egg-fried"></i>  *@
                IFood</a>
                <form method="get" class="d-flex ms-3">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" name="searchTerm">
                    <button class="btn btn-light" type="submit"><i class="bi bi-search"></i></button>
                </form>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarResponsive">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 fw-bold">
                        <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Product</a></li>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            if(User.IsInRole("user"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Cart" asp-action="Index">
                                        <i class="fa-solid fa-cart-flatbed-suitcase fs-5"></i>
                                    </a>
                                </li>
                            }
                            <li class="nav-item d-flex align-items-center">
                                <div>
                                    <a class="avatar" href="#" data-bs-toggle="dropdown" aria-expanded="false" id="avatarDropdown">
                                        <img class="avatar rounded-circle border" src="@avatarUrl" alt="User Avatar" style="width:32px;height:32px;object-fit:cover;">
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="avatarDropdown">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-bounding-box fs-5"></i> Profile</a></li>
                                        @if(User.IsInRole("admin"))
                                        {
                                            <li><a class="dropdown-item" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-card-list fs-5"></i> Manager product</a></li>
                                            <li><a class="dropdown-item" asp-area="" asp-controller="Dashboard" asp-action="OrderIndex"><i class="bi bi-card-list fs-5"></i> Manager Order</a></li>
                                        }
                                        <li><a class="dropdown-item" href="https://kienmiu.itch.io/randua-adventure"><i class="bi bi-controller"></i> Play game</a></li>
                                        @if(User.IsInRole("user"))
                                        {
                                            <li><a class="dropdown-item" asp-area="" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3 fs-5"></i> Your cart</a></li>
                                        }
                                        <li><a class="dropdown-item" asp-controller="Order" asp-action="Index"><i class="bi bi-clock-history fs-5"></i> Your History</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-in-right fs-5"></i> SignOut</a></li>
                                    </ul>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login/Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
        @await Html.PartialAsync("_chatbot")
    </main>
    <footer class="bg-dark border-top text-muted py-5 mt-5">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="section-heading text-uppercase text-white">Contact Us</h2>
                <p class="text-muted">Feel free to reach out if you have any questions.</p>
            </div>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h4 class="text-white">Contact Information</h4>
                    <p><i class="bi bi-geo-alt"></i> Address: 123 ABC Street, District X, Ho Chi Minh City</p>
                    <p><i class="bi bi-telephone"></i> Phone: (0123) 456 789</p>
                    <p><i class="bi bi-envelope"></i> Email: contact@example.com</p>
                    <p><i class="bi bi-clock"></i> Working Hours: 8:00 - 18:00 (Mon - Fri)</p>
                </div>
                <div class="col-md-6">
                    <form>
                        <div class="mb-3">
                            <label for="name" class="form-label text-white">Full Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Enter your name">
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label text-white">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="Enter your email">
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label text-white">Message</label>
                            <textarea class="form-control" id="message" rows="4" placeholder="Enter your message"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>




