@using iFood.Data
@using iFood.Data.Enum
@model Order

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    /* Reset và Base Styles - không ảnh hưởng navbar */
    .order-tracking-container {
        color: #2c3e50;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: calc(100vh - 80px); /* Trừ height của navbar */
        padding: 40px 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .order-tracking-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 40px 30px;
        border-radius: 20px;
        max-width: 900px;
        margin: 0 auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .order-header {
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f1f3f4;
        text-align: center;
    }

    .order-code {
        font-size: 28px;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 20px;
        letter-spacing: 1px;
    }

    .order-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-card {
        background: linear-gradient(135deg, #f8f9ff 0%, #e3f2fd 100%);
        padding: 20px;
        border-radius: 12px;
        border-left: 4px solid #667eea;
        text-align: left;
    }

    .info-label {
        font-size: 12px;
        font-weight: 600;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .info-value {
        font-size: 14px;
        font-weight: 500;
        color: #2c3e50;
        word-break: break-all;
    }

    /* Enhanced Progress Bar */
    .progress-container {
        margin: 50px 0;
    }

    #progressbar {
        display: flex;
        justify-content: space-between;
        padding: 0;
        list-style: none;
        margin: 0;
        position: relative;
    }

    #progressbar li {
        width: 25%;
        position: relative;
        font-size: 13px;
        color: #64748b;
        text-align: center;
        font-weight: 600;
        line-height: 1.3;
    }

    #progressbar li:before {
        content: "";
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
        border-radius: 50%;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 2;
        transition: all 0.3s ease;
        border: 3px solid #f1f5f9;
    }

    #progressbar li i {
        font-size: 24px;
        color: #64748b;
        transition: all 0.3s ease;
    }

    #progressbar li:after {
        content: '';
        width: 100%;
        height: 6px;
        background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
        position: absolute;
        left: 0;
        top: 27px;
        z-index: 1;
        border-radius: 3px;
        transition: all 0.3s ease;
    }

    #progressbar li:first-child:after {
        left: 50%;
        width: 50%;
    }

    #progressbar li:last-child:after {
        width: 50%;
    }

    /* Completed State */
    #progressbar li.completed:before {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-color: #d1fae5;
        animation: completedPulse 2s infinite;
    }

    #progressbar li.completed:after {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    #progressbar li.completed i {
        color: white;
    }

    /* Active State */
    #progressbar li.active:before {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: #e0e7ff;
        transform: scale(1.1);
        box-shadow: 0 0 20px rgba(102, 126, 234, 0.4);
    }

    #progressbar li.active:after {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    #progressbar li.active i {
        color: white;
    }

    #progressbar li.active {
        color: #667eea;
        font-weight: 700;
    }

    @@keyframes completedPulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    /* Status Cards Container */
    .status-cards-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 30px;
        border-radius: 16px;
        margin-top: 40px;
        border: 1px solid rgba(148, 163, 184, 0.2);
    }

    .status-card {
        background: white;
        border-radius: 16px;
        padding: 25px 15px;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

    .status-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
        transition: left 0.5s;
    }

    .status-card:hover::before {
        left: 100%;
    }

    .status-card.active {
        background: linear-gradient(135deg, #fff 0%, #f0f9ff 100%);
        border-color: #667eea;
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.25);
    }

    .status-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .status-card.active:hover {
        transform: translateY(-10px);
    }

    .status-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
        transition: all 0.3s ease;
        display: block;
    }

    .status-card.active .status-icon {
        transform: scale(1.1);
        filter: drop-shadow(0 6px 12px rgba(102, 126, 234, 0.3));
    }

    .status-title {
        font-weight: 600;
        font-size: 14px;
        color: #475569;
        margin-bottom: 8px;
        transition: color 0.3s ease;
    }

    .status-card.active .status-title {
        color: #667eea;
    }

    .status-description {
        font-size: 12px;
        color: #64748b;
        line-height: 1.4;
        opacity: 0.8;
    }

    .status-card.active .status-description {
        opacity: 1;
        color: #475569;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .order-tracking-container {
            padding: 20px 15px;
        }

        .order-tracking-card {
            padding: 30px 20px;
            border-radius: 15px;
        }

        .order-code {
            font-size: 22px;
        }

        .order-info-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        #progressbar li {
            font-size: 11px;
        }

        #progressbar li:before {
            width: 50px;
            height: 50px;
        }

        #progressbar li i {
            font-size: 20px;
        }

        #progressbar li:after {
            top: 22px;
        }

        .status-cards-container {
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            padding: 20px;
        }

        .status-card {
            padding: 20px 10px;
        }

        .status-icon {
            width: 50px;
            height: 50px;
        }
    }

    @@media (max-width: 480px) {
        .status-cards-container {
            grid-template-columns: 1fr;
        }

        .order-info-grid {
            gap: 10px;
        }

        .info-card {
            padding: 15px;
        }
    }

    /* Animation cho page load */
    .order-tracking-card {
        animation: slideInUp 0.6s ease-out;
    }

    @@keyframes slideInUp {
        from {
            transform: translateY(30px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    #progressbar li {
        animation: fadeInUp 0.6s ease-out forwards;
        opacity: 0;
    }

    #progressbar li:nth-child(1) { animation-delay: 0.1s; }
    #progressbar li:nth-child(2) { animation-delay: 0.2s; }
    #progressbar li:nth-child(3) { animation-delay: 0.3s; }
    #progressbar li:nth-child(4) { animation-delay: 0.4s; }

    @@keyframes fadeInUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

<div class="order-tracking-container">
    <div class="order-tracking-card">
        <div class="order-header">
            <h2 class="order-code">ORDER CODE: @Model.Ordercode</h2>
            
            <div class="order-info-grid">
                <div class="info-card">
                    <div class="info-label">Shipped by</div>
                    <div class="info-value">USPS - 234094567242423422898</div>
                </div>
                <div class="info-card">
                    <div class="info-label">Transaction ID</div>
                    <div class="info-value">@Model.TransactionId</div>
                </div>
            </div>
        </div>

        <div class="progress-container">
            <!-- Enhanced Progress Bar với Razor logic -->
            <ul id="progressbar">
                <li class="@(Model.status == Status.PendingConfirmation ? "active" : (Model.status > Status.PendingConfirmation ? "completed" : ""))">
                    <i class="fas fa-clipboard-check"></i>
                    <span>Pending<br>Confirmation</span>
                </li>
                <li class="@(Model.status == Status.Shipping ? "active" : (Model.status > Status.Shipping ? "completed" : ""))">
                    <i class="fas fa-shipping-fast"></i>
                    <span>Shipping</span>
                </li>
                <li class="@(Model.status == Status.Delivered ? "active" : (Model.status > Status.Delivered ? "completed" : ""))">
                    <i class="fas fa-truck"></i>
                    <span>Delivered</span>
                </li>
                <li class="@(Model.status == Status.Completed ? "active" : (Model.status > Status.Completed ? "completed" : ""))">
                    <i class="fas fa-check-circle"></i>
                    <span>Completed</span>
                </li>
            </ul>
        </div>

        <!-- Enhanced Status Cards với Razor logic -->
        <div class="status-cards-container">
            <div class="status-card @(Model.status >= Status.PendingConfirmation ? "active" : "")">
                <img class="status-icon" src="https://i.imgur.com/9nnc9Et.png" alt="Processed">
                <div class="status-title">Processed</div>
                <div class="status-description">Order confirmed and being processed</div>
            </div>
            
            <div class="status-card @(Model.status >= Status.Shipping ? "active" : "")">
                <img class="status-icon" src="https://i.imgur.com/u1AzR7w.png" alt="Shipping">
                <div class="status-title">Shipping</div>
                <div class="status-description">Package is in transit to you</div>
            </div>
            
            <div class="status-card @(Model.status >= Status.Delivered ? "active" : "")">
                <img class="status-icon" src="https://i.imgur.com/TkPm63y.png" alt="Delivered">
                <div class="status-title">Delivered</div>
                <div class="status-description">Package delivered successfully</div>
            </div>
            
            <div class="status-card @(Model.status == Status.Completed ? "active" : "")">
                <img class="status-icon" src="https://i.imgur.com/HdsziHP.png" alt="Completed">
                <div class="status-title">Completed</div>
                <div class="status-description">Order process completed</div>
            </div>
        </div>
    </div>
</div>