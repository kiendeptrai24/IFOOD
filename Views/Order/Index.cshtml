@model IEnumerable<Order>

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-0 text-gray-800 fw-bold">
                        <i class="bi bi-clock-history text-primary me-2"></i>
                        Order History
                    </h1>
                    <p class="text-muted mb-0">Track and manage your purchase history</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <button class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-download"></i> Export
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Container -->
    <div class="row">
        <div class="col-12">
            <div id="orderContainer" class="order-container">
                @foreach (var order in Model)
                {
                    <div class="order-card mb-4">
                        <div class="card border-0 shadow-sm">
                            <!-- Order Header -->
                            <div class="card-header bg-gradient-primary text-white border-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="order-icon me-3">
                                            <i class="bi bi-bag-check-fill fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0 fw-bold">Order #@order.Id</h5>
                                            <small class="opacity-75">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="badge bg-success fs-6 px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Completed
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Order Items -->
                            <div class="card-body p-0">
                                <div class="order-items">
                                    @foreach (var item in order.OrderDetails)
                                    {
                                        <div class="order-item">
                                            <div class="d-flex align-items-center">
                                                <div class="product-image me-3">
                                                    <div class="placeholder-image">
                                                        <i class="bi bi-image text-muted"></i>
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1 fw-semibold text-dark">
                                                        @(item.Product?.Name ?? "N/A")
                                                    </h6>
                                                    <div class="d-flex align-items-center text-muted small">
                                                        <span class="quantity-badge me-2">
                                                            <i class="bi bi-x"></i>@item.Quantity
                                                        </span>
                                                        <span class="unit-price">
                                                            $@(item.Product?.Price.ToString("0.00") ?? "0.00") each
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <div class="item-total fw-bold text-success">
                                                        $@((item.Quantity * (item.Product?.Price ?? 0)).ToString("0.00"))
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Order Footer -->
                            <div class="card-footer bg-light border-0">
                                <div class="row align-items-center">
                                    <div class="col-md-4">
                                        <div class="payment-method">
                                            <i class="bi bi-credit-card text-primary me-2"></i>
                                            <span class="fw-medium">@order.PaymentMethod</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        <div class="total-amount">
                                            <span class="text-muted small">Total Amount</span>
                                            <div class="h5 mb-0 fw-bold text-success">
                                                $@order.TotalPrice
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <div class="action-buttons">
                                            <a asp-controller="Order" asp-action="OrderDetail" asp-route-id="@order.Id" 
                                               class="btn btn-primary btn-sm me-2">
                                                <i class="bi bi-eye me-1"></i> View Details
                                            </a>
                                            <button class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-arrow-repeat"></i> Reorder
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-5" style="display: none;">
                <div class="empty-state-icon mb-3">
                    <i class="bi bi-bag-x display-1 text-muted"></i>
                </div>
                <h4 class="text-muted">No Orders Found</h4>
                <p class="text-muted">You haven't placed any orders yet.</p>
                <a href="#" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Start Shopping
                </a>
            </div>
        </div>
    </div>

    <!-- Enhanced Pagination -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div class="pagination-info text-muted">
                    <span id="paginationInfo">Showing 1-5 of 20 orders</span>
                </div>
                <nav aria-label="Order pagination">
                    <ul class="pagination pagination-modern mb-0" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<style>
/* Custom Styles for Enhanced UI */
.bg-gradient-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.order-container {
    min-height: 400px;
}

.order-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.order-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
}

.order-icon {
    width: 50px;
    height: 50px;
    background: rgba(255,255,255,0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.order-item {
    padding: 1rem;
    border-bottom: 1px solid #f1f3f4;
    transition: background-color 0.2s ease;
}

.order-item:hover {
    background-color: #f8f9fa;
}

.order-item:last-child {
    border-bottom: none;
}

.product-image {
    width: 50px;
    height: 50px;
}

.placeholder-image {
    width: 50px;
    height: 50px;
    background: #f8f9fa;
    border: 2px dashed #dee2e6;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.quantity-badge {
    background: #e3f2fd;
    color: #1976d2;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
}

.payment-method {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    background: white;
    border-radius: 8px;
    border: 1px solid #e9ecef;
}

.total-amount {
    padding: 8px 16px;
    background: #f8f9fa;
    border-radius: 8px;
    border: 1px solid #e9ecef;
}

.action-buttons .btn {
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s ease;
}

.action-buttons .btn:hover {
    transform: translateY(-1px);
}

/* Enhanced Pagination */
.pagination-modern .page-item {
    margin: 0 2px;
}

.pagination-modern .page-link {
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 500;
    color: #6c757d;
    background: #f8f9fa;
    transition: all 0.2s ease;
}

.pagination-modern .page-link:hover {
    background: #e9ecef;
    color: #495057;
    transform: translateY(-1px);
}

.pagination-modern .page-item.active .page-link {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 8px rgba(102, 126, 234, 0.3);
}

.pagination-modern .page-item.disabled .page-link {
    background: #f8f9fa;
    color: #adb5bd;
}

/* Empty State */
.empty-state-icon {
    opacity: 0.5;
}

/* Loading Animation */
@@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.order-card {
    animation: fadeInUp 0.5s ease forwards;
}

/* Responsive Design */
@@media (max-width: 768px) {
    .card-footer .row > div {
        text-align: center !important;
        margin-bottom: 1rem;
    }
    
    .card-footer .row > div:last-child {
        margin-bottom: 0;
    }
    
    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    
    .pagination-info {
        text-align: center;
        margin-bottom: 1rem;
    }
}

/* Dark mode support */
@@media (prefers-color-scheme: dark) {
    .order-item:hover {
        background-color: #2d3748;
    }
    
    .placeholder-image {
        background: #4a5568;
        border-color: #718096;
    }
    
    .payment-method,
    .total-amount {
        background: #2d3748;
        border-color: #4a5568;
        color: #e2e8f0;
    }
}
</style>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const cardsPerPage = 5;
        const orderCards = document.querySelectorAll(".order-card");
        const totalPages = Math.ceil(orderCards.length / cardsPerPage);
        const pagination = document.getElementById("pagination");
        const paginationInfo = document.getElementById("paginationInfo");
        const emptyState = document.getElementById("emptyState");
        let currentPage = 1;

        // Show empty state if no orders
        if (orderCards.length === 0) {
            emptyState.style.display = "block";
            return;
        }

        function showPage(page) {
            currentPage = page;
            
            // Add loading animation
            orderCards.forEach(card => {
                card.style.opacity = "0";
                card.style.transform = "translateY(10px)";
            });
            
            setTimeout(() => {
                // Show appropriate cards
                orderCards.forEach((card, index) => {
                    const shouldShow = index >= (page - 1) * cardsPerPage && index < page * cardsPerPage;
                    card.style.display = shouldShow ? "block" : "none";
                    
                    if (shouldShow) {
                        card.style.opacity = "1";
                        card.style.transform = "translateY(0)";
                    }
                });
                
                updatePaginationInfo();
                renderPagination();
            }, 150);
        }

        function updatePaginationInfo() {
            const start = (currentPage - 1) * cardsPerPage + 1;
            const end = Math.min(currentPage * cardsPerPage, orderCards.length);
            paginationInfo.textContent = `Showing ${start}-${end} of ${orderCards.length} orders`;
        }

        function renderPagination() {
            pagination.innerHTML = "";

            if (totalPages <= 1) return;

            function createPageItem(label, page, isDisabled = false, isActive = false, tooltip = null) {
                const li = document.createElement("li");
                li.className = `page-item ${isDisabled ? 'disabled' : ''} ${isActive ? 'active' : ''}`;
                
                const a = document.createElement("a");
                a.className = "page-link";
                a.href = "#";
                a.innerHTML = label;
                
                if (tooltip) {
                    a.title = tooltip;
                }

                a.addEventListener("click", function (e) {
                    e.preventDefault();
                    if (!isDisabled && page !== currentPage && page >= 1 && page <= totalPages) {
                        // Add smooth transition
                        pagination.style.opacity = "0.7";
                        setTimeout(() => {
                            showPage(page);
                            pagination.style.opacity = "1";
                        }, 100);
                    }
                });

                li.appendChild(a);
                pagination.appendChild(li);
            }

            // First page
            createPageItem('<i class="bi bi-chevron-double-left"></i>', 1, currentPage === 1, false, "First page");

            // Previous page
            createPageItem('<i class="bi bi-chevron-left"></i>', currentPage - 1, currentPage === 1, false, "Previous page");

            // Page numbers with smart logic
            let start = Math.max(1, currentPage - 2);
            let end = Math.min(totalPages, currentPage + 2);
            
            // Adjust if we're near the beginning or end
            if (currentPage <= 3) {
                end = Math.min(5, totalPages);
            }
            if (currentPage >= totalPages - 2) {
                start = Math.max(totalPages - 4, 1);
            }

            // Add ellipsis if needed
            if (start > 1) {
                createPageItem("1", 1);
                if (start > 2) {
                    createPageItem("...", null, true);
                }
            }

            // Page numbers
            for (let i = start; i <= end; i++) {
                createPageItem(i.toString(), i, false, i === currentPage);
            }

            // Add ellipsis if needed
            if (end < totalPages) {
                if (end < totalPages - 1) {
                    createPageItem("...", null, true);
                }
                createPageItem(totalPages.toString(), totalPages);
            }

            // Next page
            createPageItem('<i class="bi bi-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false, "Next page");

            // Last page
            createPageItem('<i class="bi bi-chevron-double-right"></i>', totalPages, currentPage === totalPages, false, "Last page");
        }

        // Keyboard navigation
        document.addEventListener("keydown", function(e) {
            if (e.target.tagName.toLowerCase() === 'input') return;
            
            switch(e.key) {
                case 'ArrowLeft':
                    if (currentPage > 1) {
                        e.preventDefault();
                        showPage(currentPage - 1);
                    }
                    break;
                case 'ArrowRight':
                    if (currentPage < totalPages) {
                        e.preventDefault();
                        showPage(currentPage + 1);
                    }
                    break;
                case 'Home':
                    if (currentPage !== 1) {
                        e.preventDefault();
                        showPage(1);
                    }
                    break;
                case 'End':
                    if (currentPage !== totalPages) {
                        e.preventDefault();
                        showPage(totalPages);
                    }
                    break;
            }
        });

        // Initialize
        showPage(1);
        
        // Add smooth transitions to order cards
        orderCards.forEach((card, index) => {
            card.style.transition = "opacity 0.3s ease, transform 0.3s ease";
            card.style.animationDelay = `${index * 0.1}s`;
        });
    });
</script>
}